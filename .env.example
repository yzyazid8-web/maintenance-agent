# Copie ce fichier en `.env` (ignoré par git) et renseigne tes valeurs.

# Backend LLM : "groq" (prod, API gratuite) ou "ollama" (local offline).
LLM_BACKEND=groq

# Clé API Groq (prod). NE JAMAIS committer la vraie clé.
# En prod HF Spaces : la définir comme secret, pas ici.
GROQ_API_KEY=

# Modèles
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
